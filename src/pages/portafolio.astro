---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { PortafolioGallery } from "../components/PortafolioGallery";
import { Footer } from "../components/Footer";
import { Comparison } from "../components/Comparison";
---

<Layout title="Portafolio | Fortex Digital Solutions">
  <Navbar client:load />

  <main>
    <!-- Page Header / Hero -->
    <section class="relative pt-40 pb-20 lg:pt-56 lg:pb-32 overflow-hidden bg-background">
      <div class="absolute inset-0 bg-linear-to-b from-blue-600/5 via-transparent to-transparent"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-[radial-gradient(circle_at_center,rgba(59,130,246,0.08)_0%,transparent_70%)] blur-[100px] pointer-events-none"></div>

      <div class="container mx-auto px-4 relative z-10 text-center">
        <div class="inline-block px-4 py-1.5 rounded-full border border-blue-500/20 bg-blue-500/5 text-blue-400 text-xs font-bold uppercase tracking-widest mb-8">
          Excelencia Digital
        </div>
        <h1 class="text-5xl lg:text-8xl font-bold text-foreground mb-8 tracking-tight">
          Portafolio <span class="text-muted">.</span>
        </h1>
        <p class="max-w-2xl mx-auto text-xl text-muted font-medium">
          Soluciones personalizadas que impulsan el crecimiento y la innovación en el mundo digital.
        </p>
      </div>
    </section>

    <PortafolioGallery client:load />
    
    <Comparison client:visible />
  </main>

  <Footer />
</Layout>
