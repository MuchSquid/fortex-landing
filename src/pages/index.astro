---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { FortexHero } from "../components/FortexHero";
import { FortexValueProp } from "../components/FortexValueProp";
import { FortexServices } from "../components/FortexServices";
import { FortexProcess } from "../components/FortexProcess";
import { Footer } from "../components/Footer";
---

<Layout title="Fortex Digital Solutions | Agencia de Transformación Digital">
  <Navbar client:load />

  <main>
    <FortexHero client:load />
    <FortexValueProp client:visible />
    <FortexServices client:visible />
    <FortexProcess client:visible />
  </main>

  <Footer />
</Layout>
